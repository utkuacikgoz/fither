#!/bin/sh
# Tests must pass to commit; engine or data changes must also pass the sim.
# Skips quietly when the workspace isn't installed (e.g. docs-only clones).

command -v pnpm >/dev/null 2>&1 || exit 0
[ -d node_modules ] || { echo "pre-commit: no install, skipping checks"; exit 0; }

pnpm release:check || { echo "pre-commit: release config failed" >&2; exit 1; }
# Typecheck BEFORE tests: vitest and jest happily run code that tsc
# rejects (a test file with a type error passes locally and fails CI —
# it did, on e619761), so the gate that catches it must run locally too.
pnpm typecheck || { echo "pre-commit: typecheck failed" >&2; exit 1; }
pnpm test || { echo "pre-commit: tests failed" >&2; exit 1; }

if git diff --cached --name-only | grep -qE '^(packages/engine/|data/)'; then
  pnpm sim || { echo "pre-commit: simulation gates failed" >&2; exit 1; }
fi
exit 0
