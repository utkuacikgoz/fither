{
  "expo": {
    "name": "FITHER",
    "slug": "fither",
    "version": "1.0.0",
    "scheme": "fither",
    "platforms": [
      "ios"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitherfitness.app",
      "buildNumber": "3",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:fither.pro"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-notifications",
      "expo-apple-authentication",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "be-ki",
          "project": "fither"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "backgroundColor": "#0B0F0C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png"
  }
}
