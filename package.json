{
  "name": "fither",
  "private": true,
  "scripts": {
    "bundle:ios": "pnpm --filter fither-app bundle:ios",
    "release:check": "node scripts/validate-release-config.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "sim": "pnpm --filter @fither/engine sim",
    "ios": "pnpm --filter fither-app ios",
    "web:test": "node --test web/test/*.test.mjs",
    "ship": "sh scripts/ship-testflight.sh"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "react-native-worklets": "0.10.1",
      "react-native-reanimated": "4.5.1"
    },
    "onlyBuiltDependencies": [
      "@sentry/cli"
    ]
  }
}
